{
  "name": "01",
  "private": true,
  "packageManager": "pnpm@10.28.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "lint": "biome check .",
    "format": "biome check --write .",
    "build": "turbo run typecheck build",
    "test": "turbo run test",
    "verify": "pnpm lint && pnpm build && pnpm test && pnpm unknowns:lint && sh verify/kit-placeholders.sh",
    "unknowns:lint": "pnpm --filter @01/unknowns exec tsx src/cli.ts lint",
    "unknowns:report": "pnpm --filter @01/unknowns exec tsx src/cli.ts report",
    "unknowns:issues": "pnpm --filter @01/unknowns exec tsx src/cli.ts issues",
    "unknowns:link": "pnpm --filter @01/unknowns exec tsx src/cli.ts link"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "turbo": "2.11.10",
    "typescript": "5.9.3"
  }
}
